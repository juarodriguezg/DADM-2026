<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase necesita Internet para mediar las partidas online -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Triqui">

        <!-- Pantalla inicial: lista de juegos disponibles -->
        <activity
            android:name=".LobbyActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Triqui">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnlineGameActivity"
            android:exported="false"
            android:theme="@style/Theme.Triqui" />

        <!-- Modo sin conexión del reto 6 (vs Android / 2 jugadores en el mismo celular) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Triqui"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
